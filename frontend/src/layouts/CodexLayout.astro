---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import AtmospherePause from '../components/AtmospherePause.astro';
import { CodexAmbient } from '../components/cinema/CodexAmbient';

interface Props {
  title: string;
  current?: string;
}
const { title, current } = Astro.props;

const AMBIENTS: Record<string, { colorA: string; colorB: string; density: number; size: number }> = {
  pandora: { colorA: '#5fffe6', colorB: '#7fff8f', density: 0.34, size: 5.2 },
  clans: { colorA: '#5fffe6', colorB: '#ffd07f', density: 0.30, size: 5.0 },
  bestiaire: { colorA: '#5fffe6', colorB: '#ff5dc4', density: 0.38, size: 5.6 },
  flore: { colorA: '#7fff8f', colorB: '#5fffe6', density: 0.42, size: 5.7 },
  personnages: { colorA: '#7fdcff', colorB: '#ff5dc4', density: 0.28, size: 5.0 },
  langue: { colorA: '#5fffe6', colorB: '#9a7fff', density: 0.26, size: 4.8 },
  films: { colorA: '#7fdcff', colorB: '#ff8c2a', density: 0.25, size: 4.8 },
  engins: { colorA: '#7fdcff', colorB: '#ff4040', density: 0.22, size: 4.6 },
  videos: { colorA: '#5fffe6', colorB: '#9a7fff', density: 0.26, size: 4.8 },
};
const ambient = AMBIENTS[current ?? ''] ?? AMBIENTS.pandora;
---
<BaseLayout title={title}>
  <!--
    Layered ambient: WebGL particles (cyan/forest-green pollen at low
    density) + CSS radial gradients + cursor-follow bioluminescent halo.
    Mimics the "Pandora floor lights up under footstep" sensation across
    the entire codex.
  -->
  <!-- (L16) The faded Pandora forest image that sat here came from the Fandom
       proxy, now removed : the codex atmosphere is particles + bio-ambient
       gradients until site-hosted illustrations exist (L17). -->
  <CodexAmbient
    client:only="react"
    colorA={ambient.colorA}
    colorB={ambient.colorB}
    density={ambient.density}
    size={ambient.size}
  />
  <div class="bio-ambient" aria-hidden="true"></div>
  <div class="cursor-glow" aria-hidden="true"></div>
  <!-- Bande pleine sous 1024 px (revue UX L6) : menu et pause fixes reposent dessus, le texte défile
       dessous au lieu de passer derrière eux. -->
  <div class="eywa-topbar" aria-hidden="true"></div>
  <AtmospherePause codex />

  <!--
    Burger mobile : visible <lg, fixe top-right, glow cyan bioluminescent.
    Toggle data-drawer-open sur <html> que la Sidebar et l'overlay observent.
  -->
  <button
    id="eywa-burger"
    type="button"
    class="eywa-burger lg:hidden"
    aria-label="Ouvrir la navigation"
    aria-controls="eywa-sidebar"
    aria-expanded="false"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path class="eywa-burger__line eywa-burger__line--top" d="M3 6h18" />
      <path class="eywa-burger__line eywa-burger__line--mid" d="M3 12h18" />
      <path class="eywa-burger__line eywa-burger__line--bot" d="M3 18h18" />
    </svg>
    <!-- Nouveautés non vues (L14) : point rose ; le nombre est dans le nom du bouton (L21). -->
    <span class="eywa-burger__dot" aria-hidden="true" hidden></span>
  </button>

  <!-- Overlay sombre cliquable derrière le drawer mobile -->
  <div id="eywa-drawer-overlay" class="eywa-drawer-overlay lg:hidden" aria-hidden="true"></div>

  <div class="flex relative" data-codex-section={current ?? 'pandora'}>
    <Sidebar current={current} />
    <main class="eywa-codex-main flex-1 px-4 sm:px-6 lg:px-10 py-12 max-w-7xl">
      <slot />
    </main>
  </div>
</BaseLayout>

<script is:inline>
  // Cursor-follow bioluminescence — like the moss waking up under Jake's foot.
  // Throttled via rAF; CSS does the rendering.
  (() => {
    if (typeof window === 'undefined') return;
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mq.matches) return;
    let pendingX = 0, pendingY = 0, ticking = false;
    const update = () => {
      document.documentElement.style.setProperty('--mx', pendingX + 'px');
      document.documentElement.style.setProperty('--my', pendingY + 'px');
      ticking = false;
    };
    window.addEventListener('mousemove', (e) => {
      pendingX = e.clientX;
      pendingY = e.clientY;
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  })();

  // Mobile drawer : burger toggles data-drawer-open on <html>. Sidebar
  // (CSS translateX) and overlay (CSS opacity/pointer-events) react.
  // Close on : Escape, overlay tap, internal nav link tap, viewport >= lg.
  // ClientRouter : ce script ne s'exécute qu'une fois alors que burger, voile et
  // tiroir sont remplacés à chaque page → écouteurs posés une seule fois sur
  // document, éléments retrouvés à chaque événement (L14 : le menu ne s'ouvrait
  // plus après une première navigation).
  (() => {
    if (typeof window === 'undefined' || window.__eywaDrawerInit) return;
    window.__eywaDrawerInit = true;
    const html = document.documentElement;
    const isOpen = () => html.getAttribute('data-drawer-open') === 'true';

    let savedScrollY = 0;
    const lockScroll = () => {
      savedScrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    };
    const unlockScroll = () => {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      window.scrollTo(0, savedScrollY);
    };

    // Accessibilité clavier (revue UX L14, WCAG 2.4.3 / 2.4.11) — sous 1024 px :
    // tiroir fermé = inerte (ses liens hors écran ne prennent plus le focus) ;
    // tiroir ouvert = le reste de la page inerte et Tab bouclé tiroir ↔ bouton menu.
    const mql = window.matchMedia('(min-width: 1024px)');
    const syncInert = () => {
      const sidebar = document.getElementById('eywa-sidebar');
      const burger = document.getElementById('eywa-burger');
      const overlay = document.getElementById('eywa-drawer-overlay');
      if (!sidebar) return;
      const desktop = mql.matches;
      const open = isOpen() && !desktop;
      sidebar.inert = !desktop && !open;
      const shell = sidebar.parentElement;
      // Tout ce qui n'est ni le tiroir ni le bouton : le contenu principal et les
      // autres enfants de <body> (visionneuse, son d'ambiance…).
      const others = [
        ...(shell ? [...shell.children].filter((c) => c !== sidebar) : []),
        ...[...document.body.children].filter((c) => c !== shell && c !== burger && !c.contains(sidebar)),
      ];
      for (const el of others) {
        // Le voile doit rester cliquable : il referme le tiroir.
        if (el === overlay || el.tagName === 'SCRIPT' || el.tagName === 'STYLE') continue;
        el.inert = open;
      }
    };
    const focusables = () => {
      const sidebar = document.getElementById('eywa-sidebar');
      const burger = document.getElementById('eywa-burger');
      const inside = sidebar ? [...sidebar.querySelectorAll('a[href], button:not([disabled])')] : [];
      return burger ? [burger, ...inside] : inside;
    };

    const setOpen = (open, { returnFocus = false } = {}) => {
      const burger = document.getElementById('eywa-burger');
      if (open) {
        html.setAttribute('data-drawer-open', 'true');
        burger?.setAttribute('aria-expanded', 'true');
        burger?.setAttribute('aria-label', 'Fermer la navigation');
        lockScroll();
      } else {
        html.removeAttribute('data-drawer-open');
        burger?.setAttribute('aria-expanded', 'false');
        // L21 : au repos, le nom annonce les nouveautés non vues (posé par le script de la
        // pastille, BaseLayout).
        const unseen = burger?.dataset.newsUnseen;
        burger?.setAttribute('aria-label', unseen ? `Ouvrir la navigation (${unseen})` : 'Ouvrir la navigation');
        unlockScroll();
      }
      syncInert();
      if (!open && returnFocus) burger?.focus();
    };

    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (!el) return;
      if (el.closest('#eywa-burger')) { setOpen(!isOpen()); return; }
      if (el.closest('#eywa-drawer-overlay')) { setOpen(false, { returnFocus: true }); return; }
      // Tap sur n'importe quel lien interne du drawer = fermer
      if (isOpen() && el.closest('#eywa-sidebar a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') { setOpen(false, { returnFocus: true }); return; }
      if (e.key !== 'Tab') return;
      const list = focusables();
      if (!list.length) return;
      const i = list.indexOf(document.activeElement);
      const next = e.shiftKey
        ? list[(i <= 0 ? list.length : i) - 1]
        : list[(i + 1) % list.length];
      e.preventDefault();
      next.focus();
    });
    // Si l'utilisateur passe en >= lg avec drawer ouvert → fermer + clean lock
    mql.addEventListener?.('change', () => {
      if (mql.matches && isOpen()) setOpen(false);
      else syncInert();
    });
    // Nouvelle page (ClientRouter) : tiroir fermé, inertie recalculée sur le nouveau DOM.
    document.addEventListener('astro:after-swap', syncInert);
    syncInert();
  })();

  // Pandora feels more alive when the glow reacts to lore, not to every
  // word. Highlight only key universe terms inside article prose.
  (() => {
    if (typeof window === 'undefined') return;
    const TERMS = [
      'Eywa', 'tsaheylu', 'Na’vi', "Na'vi", 'Pandora', 'Omatikaya',
      'Metkayina', 'Ash People', 'Arbre des Âmes', 'Hometree',
      'Ikran', 'Toruk', 'Toruk Makto', 'Thanator', 'Tulkun', 'Pa’li',
      "Pa'li", 'Ilu', 'Skimwing', 'Woodsprites', 'Atokirina',
      'RDA', 'Unobtanium', 'Hallelujah', 'Sa’nok', "Sa'nok",
    ].sort((a, b) => b.length - a.length);
    const escapeRegExp = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const termRe = new RegExp(`(${TERMS.map(escapeRegExp).join('|')})`, 'gi');

    const wrapTextNode = (node) => {
      const text = node.textContent ?? '';
      if (!termRe.test(text)) return;
      termRe.lastIndex = 0;
      const frag = document.createDocumentFragment();
      let last = 0;
      text.replace(termRe, (match, _term, index) => {
        if (index > last) frag.appendChild(document.createTextNode(text.slice(last, index)));
        const span = document.createElement('span');
        span.className = 'bio-word bio-term';
        span.textContent = match;
        frag.appendChild(span);
        last = index + match.length;
        return match;
      });
      if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
      node.parentNode?.replaceChild(frag, node);
    };

    const split = () => {
      const ps = document.querySelectorAll('article p, article li');
      ps.forEach((p) => {
        if (p.dataset.bioSplit === '1') return;
        const walker = document.createTreeWalker(p, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            if (!node.textContent?.trim()) return NodeFilter.FILTER_REJECT;
            const parent = node.parentElement;
            if (!parent || parent.closest('a, code, pre, .bio-word')) {
              return NodeFilter.FILTER_REJECT;
            }
            return NodeFilter.FILTER_ACCEPT;
          },
        });
        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach(wrapTextNode);
        p.dataset.bioSplit = '1';
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', split);
    } else {
      split();
    }
    document.addEventListener('astro:page-load', split);
  })();
</script>

<style>
  .bio-ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 15% 15%, rgba(95, 255, 230, 0.12), transparent 70%),
      radial-gradient(ellipse 50% 35% at 85% 35%, rgba(255, 93, 196, 0.10), transparent 70%),
      radial-gradient(ellipse 70% 50% at 50% 90%, rgba(127, 255, 143, 0.08), transparent 70%),
      radial-gradient(ellipse 40% 30% at 80% 80%, rgba(255, 140, 42, 0.06), transparent 70%);
    animation: bio-drift 28s ease-in-out infinite alternate;
  }

  /* Subtle blob drift so the wash feels alive, not static. */
  @keyframes bio-drift {
    0% {
      background-position: 0% 0%, 100% 0%, 0% 100%, 100% 100%;
    }
    100% {
      background-position: 5% 8%, 95% 6%, 4% 92%, 96% 94%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-ambient {
      animation: none;
    }
  }

  /*
    Cursor-follow halo. A 360px-radius cyan glow centered on (--mx, --my).
    Pointer-events none so it doesn't capture clicks. Fades in/out via
    smooth opacity transition when the mouse stops/starts moving.
  */
  .cursor-glow {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%),
      rgba(95, 255, 230, 0.10),
      rgba(127, 255, 143, 0.04) 40%,
      transparent 70%);
    mix-blend-mode: screen;
    transition: background 80ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-glow {
      display: none;
    }
  }

  /*
    Devices without hover (mobile/tablet) never see the cursor — kill
    the static cyan halo at (50%,50%) it would otherwise leave behind.
    The bio-word random pulse below replaces it as the "Pandora is
    alive" signal on tactile.
  */
  @media (hover: none) {
    .cursor-glow {
      display: none;
    }
  }

  /* Ensure the sidebar + main content render above the ambient layer. */
  :global(main) {
    position: relative;
    z-index: 2;
  }
  /* Sidebar : sur lg+ position:relative au-dessus de l'ambient.
     Sur <lg elle est fixed (drawer) et doit passer au-dessus de l'overlay. */
  :global(aside.eywa-sidebar) {
    z-index: 50;
  }
  @media (min-width: 1024px) {
    :global(aside.eywa-sidebar) {
      z-index: 2;
    }
  }

  /*
    Article body text gets a soft dark text-shadow so it stays legible
    against the drifting WebGL pollen behind. Subtle — not embossed,
    just enough to lift the words above the busy background.
  */
  :global(article p),
  :global(article li),
  :global(article h1),
  :global(article h2),
  :global(article h3),
  :global(article h4) {
    text-shadow:
      0 1px 2px rgba(10, 10, 31, 0.85),
      0 0 12px rgba(10, 10, 31, 0.55);
  }

  /* Bio-word hover styles live in src/styles/global.css now — they're
     reused by the landing tagline in addition to the codex prose. */

  /*
    Burger button — fixed top-right, glow cyan bioluminescent qui matche
    l'identité Eywa. Visible <lg seulement (Tailwind lg:hidden côté DOM).
    Z-index plus haut que la sidebar pour rester accessible quand drawer
    fermé, et au-dessus de l'overlay quand ouvert.
  */
  .eywa-topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 4.1rem;
    z-index: 39; /* sous le voile du tiroir (40), au-dessus du contenu (2) */
    background: rgba(8, 12, 22, 0.96);
    border-bottom: 1px solid rgba(95, 255, 230, 0.12);
    backdrop-filter: blur(6px);
  }
  @media (min-width: 1024px) {
    .eywa-topbar { display: none; }
  }
  /* Le contenu commence sous la bande. */
  @media (max-width: 1023px) {
    :global(main.eywa-codex-main) { padding-top: 5.5rem; }
  }
  .eywa-burger {
    position: fixed;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 60;
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 8px;
    border: 1px solid rgba(95, 255, 230, 0.35);
    background: rgba(8, 12, 22, 0.78);
    color: var(--color-eywa-bio-primary, #5fffe6);
    cursor: pointer;
    backdrop-filter: blur(6px);
    box-shadow:
      0 0 18px -6px rgba(95, 255, 230, 0.55),
      inset 0 0 0 1px rgba(95, 255, 230, 0.12);
    transition: box-shadow 200ms ease, transform 150ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  /* Le display ci-dessus (style scopé, hors couche) écrasait lg:hidden de Tailwind :
     le bouton s'affichait au bureau et bloquait le défilement (revue UX L14). */
  @media (min-width: 1024px) {
    .eywa-burger {
      display: none;
    }
  }
  .eywa-burger:active {
    transform: scale(0.96);
  }
  .eywa-burger svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .eywa-burger__dot {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--color-eywa-bio-secondary, #ff5dc4);
    box-shadow: 0 0 0 2px #0a0a1f, 0 0 10px rgba(255, 93, 196, 0.8);
  }
  .eywa-burger__dot[hidden] {
    display: none;
  }
  /* Tiroir ouvert : le bouton devient une croix, le point rose n'y a plus de sens
     (revue UX L20). */
  :global(html[data-drawer-open="true"]) .eywa-burger__dot {
    display: none;
  }
  .eywa-burger__line {
    transition: transform 250ms ease, opacity 200ms ease;
    transform-origin: center;
  }
  /* Burger → croix quand drawer ouvert */
  :global(html[data-drawer-open="true"]) .eywa-burger__line--top {
    transform: translateY(6px) rotate(45deg);
  }
  :global(html[data-drawer-open="true"]) .eywa-burger__line--mid {
    opacity: 0;
  }
  :global(html[data-drawer-open="true"]) .eywa-burger__line--bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /*
    Overlay — sombre, derrière le drawer mais devant le contenu. Animation
    opacity quand data-drawer-open passe à true.
  */
  .eywa-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(2, 6, 14, 0.65);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }
  :global(html[data-drawer-open="true"]) .eywa-drawer-overlay {
    opacity: 1;
    pointer-events: auto;
  }
</style>
