---
/**
 * Hero banner pour les section indexes du codex.
 * Image grand format (21:9 cinéma) avec titre + sous-titre + tagline
 * en overlay sur un dégradé qui s'éteint vers le bas pour la lisibilité.
 * Donne à chaque section un punch visuel "magazine cover" avant la grille
 * de cards.
 */
interface Props {
  roman: string;
  label: string;
  title: string;
  tagline: string;
  cover?: string;
}
import CoverFallback from './CoverFallback.astro';
import { coverImageSrc } from '../lib/cover';

const { roman, label, title, tagline, cover } = Astro.props;

// Image hébergée par le site, sinon visuel par défaut (proxy Fandom retiré, L16).
const imgSrc = coverImageSrc(cover);
---
<header class="section-hero">
  {imgSrc
    ? <img src={imgSrc} alt="" class="section-hero__img" />
    : <CoverFallback mark={false} />}
  <div class="section-hero__veil"></div>
  <div class="section-hero__content">
    <p class="section-hero__roman">{roman} — {label}</p>
    <h1 class="section-hero__title">{title}</h1>
    <p class="section-hero__tagline">{tagline}</p>
  </div>
</header>

<style>
  .section-hero {
    position: relative;
    /* Mobile : 16:10 (lisible sur tel), desktop : 21:9 (cinéma). */
    /* Sous 768 px le texte est dans le flux : le bandeau grandit avec lui au lieu de
       le rogner (WCAG 1.4.10). Le 16:10 n'est qu'un minimum, tenu par ::before
       (aspect-ratio ne le ferait pas : overflow: hidden annule la taille minimale
       automatique). */
    display: flex;
    align-items: flex-end;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid rgba(232, 230, 221, 0.1);
    box-shadow:
      0 0 0 1px rgba(95, 255, 230, 0.06) inset,
      0 0 30px -8px rgba(95, 255, 230, 0.20);
  }
  .section-hero::before {
    content: '';
    flex: none;
    width: 0;
    padding-top: 62.5%;
  }
  @media (min-width: 768px) {
    .section-hero {
      aspect-ratio: 21 / 9;
    }
    .section-hero::before {
      display: none;
    }
  }

  .section-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05);
    /*
      "Living hero" — two decoupled cycles on different durations so the
      combined motion feels organic, not periodic.
       - Ken Burns : slow pan + zoom (20s, alternate)
       - Breath : bioluminescent brightness/saturation breathing (7s, alternate)
      Slight will-change hint for smoother compositing on low-end GPUs.
    */
    transform-origin: 55% 45%;
    will-change: transform, filter;
    animation:
      hero-kenburns 20s ease-in-out infinite alternate,
      hero-breath 7s ease-in-out infinite alternate;
  }

  /*
    Multi-stop veil : bottom-left dark for the title overlay readability,
    overall slight cyan tint for the bioluminescent feel, top-right
    lighter so the image still breathes. Also pulses very slightly to give
    the impression of light shifting through Pandora's canopy.
  */
  .section-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg,
        rgba(10, 10, 31, 0.70) 0%,
        rgba(10, 10, 31, 0.30) 35%,
        rgba(10, 10, 31, 0.10) 70%),
      linear-gradient(to top,
        rgba(10, 10, 31, 0.85) 0%,
        rgba(10, 10, 31, 0.20) 50%,
        transparent 100%);
    animation: hero-veil-pulse 11s ease-in-out infinite alternate;
  }

  @keyframes hero-kenburns {
    from {
      transform: scale(1) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.06) translate3d(-1.2%, -1.5%, 0);
    }
  }

  @keyframes hero-breath {
    from {
      filter: saturate(1.05) brightness(1);
    }
    to {
      filter: saturate(1.18) brightness(1.08);
    }
  }

  @keyframes hero-veil-pulse {
    from { opacity: 1; }
    to   { opacity: 0.95; }
  }

  /* Accessibility — respect prefers-reduced-motion strictly. */
  @media (prefers-reduced-motion: reduce) {
    .section-hero__img,
    .section-hero__veil {
      animation: none;
    }
    .section-hero__img {
      transform: none;
      filter: saturate(1.05);
    }
  }

  .section-hero__content {
    position: relative;
    width: 100%;
    padding: 1.25rem 1.25rem 1.1rem;
  }
  @media (min-width: 768px) {
    .section-hero__content {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 2.5rem 2.5rem 2rem;
    }
  }

  .section-hero__roman {
    font-family: var(--font-display);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-eywa-bio-primary);
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 6px rgba(10, 10, 31, 0.85);
  }

  .section-hero__title {
    font-family: var(--font-display);
    font-size: 1.85rem;
    line-height: 1.05;
    color: var(--color-eywa-text);
    text-shadow:
      0 2px 12px rgba(10, 10, 31, 0.95),
      0 0 30px rgba(95, 255, 230, 0.20);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .section-hero__title {
      font-size: 2.75rem;
    }
  }

  @media (min-width: 768px) {
    .section-hero__title {
      font-size: 3.5rem;
    }
  }

  .section-hero__tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.125rem;
    color: rgba(232, 230, 221, 0.85);
    text-shadow: 0 2px 6px rgba(10, 10, 31, 0.85);
    max-width: 40rem;
  }
</style>
