---
/*
  L20 — Plan de travail : ce qui est en cours, prévu et récemment livré sur le codex,
  inspiré de la page « À venir » d'AetherWX, repris d'evatosorus (après sa relecture et sa
  revue UX).

  Source : .cadence/raf.yaml (tenu par raf, cadence), lu AU BUILD — absent ou illisible,
  le build échoue (jamais une page vide). On ne publie que les lots visibles qui ont un
  TITRE PUBLIC (champ public: du plan, sinon titre de leur Nouveauté ; jamais le titre
  brut), avec leur état et le décompte de leurs étapes (liste blanche de
  lib/plan-public.ts) : titres bruts, notes, verdicts UX, raisons d'abandon et titres
  d'étapes ne sont jamais rendus (scripts/plan-page.e2e.test.mjs le vérifie sur tout dist/).
*/
import { join } from 'node:path';
import CodexLayout from '../layouts/CodexLayout.astro';
import MetaHeader from '../components/MetaHeader.astro';
import FrDate from '../components/FrDate.astro';
import { loadPublicPlan, planSummary, stepsLabel, RECENT_DONE, type PublicLot } from '../lib/plan-public';
import news from '../../public/nouveautes-data/nouveautes.json';

// Build lancé depuis frontend/ (npm run build ; Cloudflare Pages : racine du dépôt,
// « cd frontend && npm install && npm run build ») : le plan est un cran au-dessus.
const plan = loadPublicPlan(join(process.cwd(), '..', '.cadence', 'raf.yaml'), news.entries);

const summary = planSummary(plan.counts);

// Apostrophes typographiques (’) : un titre repris d'une Nouveauté peut en porter de droites.
const typo = (t: string) => t.replace(/'/g, '’');

const sections: { id: string; title: string; intro: string; lots: PublicLot[]; empty: string; news?: boolean }[] = [
  { id: 'en-cours', title: 'En cours', intro: 'Ce qui pousse en ce moment dans le codex.', lots: plan.doing, empty: 'Rien en cours pour l’instant.' },
  { id: 'prevu', title: 'Prévu', intro: 'La suite, dans l’ordre du plan.', lots: plan.todo, empty: 'Les prochains travaux seront annoncés ici.' },
  {
    id: 'livre',
    title: 'Récemment livré',
    intro: plan.counts.done > RECENT_DONE
      ? `Les ${RECENT_DONE} derniers travaux terminés, sur ${plan.counts.done} au total.`
      : 'Les derniers travaux terminés.',
    news: true,
    lots: plan.done,
    empty: 'Rien de livré pour l’instant.',
  },
];
---
<CodexLayout title="Plan de travail — Eywa" current="plan">
  <div class="plan">
    <MetaHeader
      eyebrow="Plan de travail · Eywa"
      title="Ce qui se prépare"
      lede="Ce qui est en cours sur le codex, ce qui suit et ce qui vient d’arriver, mis à jour à chaque publication du site."
    />

    {summary.length > 0 && (
      <p class="plan-summary">
        {summary.map((part, i) => (
          <Fragment>
            {i > 0 && <span aria-hidden="true" class="plan-sep">·</span>}
            <span>{part}</span>
          </Fragment>
        ))}
      </p>
    )}

    {sections.map((s) => (
      <section class="plan-section" aria-labelledby={`plan-${s.id}`}>
        <h2 id={`plan-${s.id}`}>{s.title}{s.lots.length > 0 && <Fragment> <span class="plan-count">({s.lots.length})</span></Fragment>}</h2>
        <p class="plan-intro">
          {s.intro}
          {s.news && <Fragment> Ce qui change à l’écran est raconté dans les <a href="/nouveautes/">Nouveautés</a>.</Fragment>}
        </p>
        {s.lots.length === 0 ? (
          <p class="plan-empty">{s.empty}</p>
        ) : (
          <ol class="plan-list">
            {s.lots.map((l) => (
              <li class="plan-lot" data-status={l.status} data-id={l.id} id={`lot-${l.id}`} data-also={l.also?.join(' ')}>
                <p class="plan-lot-title">{typo(l.title)}</p>
                {/* Revue UX L20 : l'état est celui du groupe (titre de section), pas répété
                    ici ; seulement la date d'un lot livré et l'avancement s'il y en a un. */}
                {(l.finished || l.tasks) && (
                  <p class="plan-lot-meta">
                    {l.finished && <time class="plan-date" datetime={l.finished}><FrDate day={l.finished} /></time>}
                    {l.tasks && <span class="plan-tasks">{stepsLabel(l.tasks)}</span>}
                  </p>
                )}
              </li>
            ))}
          </ol>
        )}
      </section>
    ))}
  </div>

  <style>
    .plan {
      max-width: 46rem;
    }
    /* Bandeau et sections sur la même carte de nuit quasi opaque que les Nouveautés :
       le texte garde son contraste quoi que le pollen et le halo du curseur fassent
       passer derrière. */
    .plan-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 0.7rem;
      margin: -1rem 0 1.75rem;
      padding: 0.6rem 1rem;
      background: rgba(8, 12, 22, 0.92);
      border-left: 3px solid var(--color-eywa-bio-primary);
      border-radius: 4px;
      font-family: var(--font-body);
      font-size: 1.05rem;
      color: var(--color-eywa-text);
    }
    .plan-sep {
      color: var(--color-eywa-bio-primary);
    }
    .plan-section {
      margin: 0 0 1.75rem;
      padding: 1.5rem clamp(1rem, 4vw, 1.8rem) 1.25rem;
      background: rgba(8, 12, 22, 0.92);
      border: 1px solid rgba(95, 255, 230, 0.18);
      border-left: 3px solid var(--color-eywa-bio-primary);
      border-radius: 6px;
      box-shadow: 0 0 30px -12px rgba(95, 255, 230, 0.35);
    }
    .plan-section h2 {
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 4vw, 1.3rem);
      font-weight: 600;
      letter-spacing: 0.03em;
      line-height: 1.4;
      color: var(--color-eywa-bio-primary);
      margin: 0 0 0.4rem;
    }
    .plan-count {
      color: var(--color-eywa-text-muted);
      font-size: 0.85em;
      font-weight: 400;
    }
    .plan-intro,
    .plan-empty {
      margin: 0 0 1rem;
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.6;
      color: var(--color-eywa-text-muted);
    }
    .plan-intro a {
      color: var(--color-eywa-bio-primary);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .plan-intro a:focus-visible {
      outline: 2px solid var(--color-eywa-bio-primary);
      outline-offset: 2px;
      border-radius: 2px;
    }
    .plan-empty {
      font-style: italic;
    }
    .plan-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .plan-lot {
      padding: 0.85rem 0;
      border-top: 1px solid rgba(95, 255, 230, 0.14);
    }
    .plan-lot-title {
      margin: 0 0 0.35rem;
      font-family: var(--font-body);
      font-size: 1.12rem;
      line-height: 1.55;
      color: var(--color-eywa-text);
      overflow-wrap: anywhere;
    }
    .plan-lot-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.3rem 0.9rem;
      margin: 0;
      font-family: var(--font-body);
      font-size: 0.98rem;
      color: var(--color-eywa-text-muted);
    }
    /* Date de livraison : même ligne en capitales espacées que les dates des Nouveautés. */
    .plan-date {
      font-family: var(--font-display);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.72rem;
      color: var(--color-eywa-text-muted);
    }
  </style>
</CodexLayout>
